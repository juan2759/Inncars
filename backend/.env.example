# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite (desarrollo local)
DATABASE_URL=sqlite:///./automotora.db
# PostgreSQL (producción — Railway/Render lo setean automáticamente)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esto-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Cloudinary (fotos de vehículos en producción) ─────────────────────────────
# Crear cuenta gratis en https://cloudinary.com
# Dashboard → API Keys → copiar los 3 valores
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CORS (orígenes permitidos) ────────────────────────────────────────────────
# En producción dejar vacío (el frontend corre en el mismo origen)
# En desarrollo: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Archivos locales (solo sin Cloudinary) ────────────────────────────────────
UPLOAD_DIR=../uploads
